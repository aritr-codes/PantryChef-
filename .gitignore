# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/
ENV/
.env
.env.local

# uv  (uv.lock IS committed — reproducibility)

# Data — tracked via docs/DATASET.md, not git
data/raw/*
data/interim/*
data/processed/*
data/processed/usda.json  # USDA FDC artifact (built via scripts/fetch_usda.py; redundant w/ above, kept explicit)
!data/**/.gitkeep
datasets/
*.csv
*.parquet
*.jsonl
*.npy
*.h5
*.db
*.sqlite

# Models / artifacts — tracked via MLflow + model cards
models/*
!models/.gitkeep
checkpoints/
*.pt
*.pth
*.onnx
*.bin
*.pkl
*.joblib

# Experiment tracking
experiments/mlruns/
mlruns/
mlflow.db
*.log
logs/

# DVC
.dvc/
*.dvc

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# GISMo published benchmark (CC BY-NC 4.0 — do not commit their data or derivations;
# regenerate via scripts/fetch_gismo_gold.py). Redundant with the data/*.pkl/*.csv
# rules above, but kept explicit so the license obligation is unmissable.
data/raw/gismo/
data/eval/subs_gold_gismo.csv

# NOTE: notebooks ARE committed (thin convention) — do not ignore *.ipynb
